# SAMPLE does not need this file. Copy it only when enabling REAL collection.
PORT=8080
GITHUB_APP_ID=000000
GITHUB_INSTALLATION_ID=000000
GITHUB_ENTERPRISE=example-enterprise
GITHUB_APP_PRIVATE_KEY_FILE=/path/outside/project/github-app-private-key.pem
# Match the non-root host UID that owns the 0600 key; do not use UID 0.
COLLECTOR_UID=10001
COLLECT_DAYS=7
COLLECT_INTERVAL_SECONDS=86400
ALLOW_MISSING_METRICS=false
