{
  "name": "Copilot Metrics",
  "compatibilityLevel": 1600,
  "model": {
    "culture": "en-US",
    "sourceQueryCulture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "annotations": [
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "0"
      }
    ],
    "expressions": [
      {
        "name": "DataMode",
        "kind": "m",
        "expression": "\"SAMPLE\" meta [IsParameterQuery=true, List={\"SAMPLE\", \"REAL\"}, DefaultValue=\"SAMPLE\", Type=\"Text\", IsParameterQueryRequired=true]"
      },
      {
        "name": "DataRootPath",
        "kind": "m",
        "expression": "\"C:/CopilotMetrics/data\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      },
      {
        "name": "Dataset",
        "kind": "m",
        "expression": [
          "let",
          "  Raw = if DataMode = \"SAMPLE\" then Json.Document(Binary.FromText(\"\", BinaryEncoding.Base64))",
          "    else if DataMode = \"REAL\" then Json.Document(File.Contents(DataRootPath & \"/dataset.json\"))",
          "    else error \"DataMode must be SAMPLE or REAL\",",
          "  Checked = if Raw[Info]{0}[Mode] = DataMode then Raw",
          "    else error \"Dataset provenance does not match DataMode\"",
          "in Checked"
        ]
      }
    ],
    "tables": [
      {
        "name": "Info",
        "columns": [
          {
            "name": "Mode",
            "dataType": "string",
            "sourceColumn": "Mode",
            "summarizeBy": "none"
          },
          {
            "name": "Label",
            "dataType": "string",
            "sourceColumn": "Label",
            "summarizeBy": "none"
          },
          {
            "name": "AsOf",
            "dataType": "string",
            "sourceColumn": "AsOf",
            "summarizeBy": "none"
          },
          {
            "name": "StartDay",
            "dataType": "dateTime",
            "sourceColumn": "StartDay",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "EndDay",
            "dataType": "dateTime",
            "sourceColumn": "EndDay",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "Enterprise",
            "dataType": "string",
            "sourceColumn": "Enterprise",
            "summarizeBy": "none"
          },
          {
            "name": "Coverage",
            "dataType": "string",
            "sourceColumn": "Coverage",
            "summarizeBy": "none"
          },
          {
            "name": "SchemaVersion",
            "dataType": "string",
            "sourceColumn": "SchemaVersion",
            "summarizeBy": "none"
          },
          {
            "name": "LicenseSnapshotAsOf",
            "dataType": "string",
            "sourceColumn": "LicenseSnapshotAsOf",
            "summarizeBy": "none"
          },
          {
            "name": "LicenseRosterStatus",
            "dataType": "string",
            "sourceColumn": "LicenseRosterStatus",
            "summarizeBy": "none"
          },
          {
            "name": "HistoricalLicenseCoverage",
            "dataType": "string",
            "sourceColumn": "HistoricalLicenseCoverage",
            "summarizeBy": "none"
          },
          {
            "name": "MetricsStartDay",
            "dataType": "dateTime",
            "sourceColumn": "MetricsStartDay",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "MetricsEndDay",
            "dataType": "dateTime",
            "sourceColumn": "MetricsEndDay",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "BillingStartDay",
            "dataType": "dateTime",
            "sourceColumn": "BillingStartDay",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "BillingEndDay",
            "dataType": "dateTime",
            "sourceColumn": "BillingEndDay",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "MissingMetricsDays",
            "dataType": "double",
            "sourceColumn": "MissingMetricsDays",
            "summarizeBy": "sum"
          },
          {
            "name": "MetricsCoverageStatus",
            "dataType": "string",
            "sourceColumn": "MetricsCoverageStatus",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Info",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "  Rows = Table.FromRecords(Dataset[Info], {\"Mode\", \"Label\", \"AsOf\", \"StartDay\", \"EndDay\", \"Enterprise\", \"Coverage\", \"SchemaVersion\", \"LicenseSnapshotAsOf\", \"LicenseRosterStatus\", \"HistoricalLicenseCoverage\", \"MetricsStartDay\", \"MetricsEndDay\", \"BillingStartDay\", \"BillingEndDay\", \"MissingMetricsDays\", \"MetricsCoverageStatus\"}, MissingField.UseNull),",
                "  ParsedDates = Table.TransformColumns(Rows, {{\"StartDay\", each if _ = null then null else Date.FromText(_), type date}, {\"EndDay\", each if _ = null then null else Date.FromText(_), type date}, {\"MetricsStartDay\", each if _ = null then null else Date.FromText(_), type date}, {\"MetricsEndDay\", each if _ = null then null else Date.FromText(_), type date}, {\"BillingStartDay\", each if _ = null then null else Date.FromText(_), type date}, {\"BillingEndDay\", each if _ = null then null else Date.FromText(_), type date}}),",
                "  Typed = Table.TransformColumnTypes(ParsedDates, {{\"Mode\", type text}, {\"Label\", type text}, {\"AsOf\", type text}, {\"StartDay\", type date}, {\"EndDay\", type date}, {\"Enterprise\", type text}, {\"Coverage\", type text}, {\"SchemaVersion\", type text}, {\"LicenseSnapshotAsOf\", type text}, {\"LicenseRosterStatus\", type text}, {\"HistoricalLicenseCoverage\", type text}, {\"MetricsStartDay\", type date}, {\"MetricsEndDay\", type date}, {\"BillingStartDay\", type date}, {\"BillingEndDay\", type date}, {\"MissingMetricsDays\", type number}, {\"MetricsCoverageStatus\", type text}}, \"en-US\")",
                "in Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Data source",
            "expression": "SELECTEDVALUE(Info[Label], \"ERROR: ambiguous source\")"
          },
          {
            "name": "Exported UTC",
            "expression": "SELECTEDVALUE(Info[AsOf])"
          },
          {
            "name": "Gross AI credits",
            "expression": "CALCULATE(SUM(Billing[grossQuantity]), KEEPFILTERS(Billing[UnitType] = \"ai-credits\"))",
            "formatString": "#,0.00"
          },
          {
            "name": "Net API AI credits",
            "expression": "CALCULATE(SUM(Billing[netQuantity]), KEEPFILTERS(Billing[UnitType] = \"ai-credits\"))",
            "formatString": "#,0.00"
          },
          {
            "name": "Gross amount USD",
            "expression": "CALCULATE(SUM(Billing[grossAmount]), KEEPFILTERS(Billing[UnitType] = \"ai-credits\"))",
            "formatString": "\"$\"#,0.00"
          },
          {
            "name": "Discounts USD",
            "expression": "CALCULATE(SUM(Billing[discountAmount]), KEEPFILTERS(Billing[UnitType] = \"ai-credits\"))",
            "formatString": "\"$\"#,0.00"
          },
          {
            "name": "Net cost USD",
            "expression": "CALCULATE(SUM(Billing[netAmount]), KEEPFILTERS(Billing[UnitType] = \"ai-credits\"))",
            "formatString": "\"$\"#,0.00"
          },
          {
            "name": "Users with billing detail",
            "expression": "VAR Value = CALCULATE(DISTINCTCOUNT(Billing[User]), Billing[User] <> \"(no user detail)\") RETURN IF(NOT ISBLANK(Value), Value, IF(COUNTROWS(VALUES('Dates'[Day])) > 0 && COUNTROWS(VALUES('Dates'[Day])) = CALCULATE(COUNTROWS(SourceCoverage), KEEPFILTERS(SourceCoverage[BillingAvailable] = TRUE())), 0))",
            "formatString": "#,0"
          },
          {
            "name": "Unattributed user credits",
            "expression": "VAR Value = CALCULATE([Gross AI credits], Billing[User] = \"(no user detail)\") RETURN IF(NOT ISBLANK(Value), Value, IF(COUNTROWS(VALUES('Dates'[Day])) > 0 && COUNTROWS(VALUES('Dates'[Day])) = CALCULATE(COUNTROWS(SourceCoverage), KEEPFILTERS(SourceCoverage[BillingAvailable] = TRUE())), 0))",
            "formatString": "#,0.00"
          },
          {
            "name": "Observed users",
            "expression": "VAR Value = DISTINCTCOUNT(Metrics[User]) RETURN IF(NOT ISBLANK(Value), Value, IF([Complete metrics coverage] = 1, 0))",
            "formatString": "#,0"
          },
          {
            "name": "Interactions",
            "expression": "SUM(Metrics[Interactions])",
            "formatString": "#,0"
          },
          {
            "name": "Generations",
            "expression": "SUM(Metrics[Generations])",
            "formatString": "#,0"
          },
          {
            "name": "Acceptances",
            "expression": "SUM(Metrics[Acceptances])",
            "formatString": "#,0"
          },
          {
            "name": "Activity acceptance rate",
            "expression": "DIVIDE([Acceptances], [Generations])",
            "formatString": "0.0%"
          },
          {
            "name": "Lines added",
            "expression": "SUM(Metrics[LinesAdded])",
            "formatString": "#,0"
          },
          {
            "name": "Telemetry AI credits",
            "expression": "SUM(Metrics[TelemetryCredits])",
            "formatString": "#,0.00"
          },
          {
            "name": "Model feature interactions",
            "expression": "SUM(ModelFeatures[Interactions])",
            "formatString": "#,0"
          },
          {
            "name": "Server requests",
            "expression": "SUM(ClientModels[Requests])",
            "formatString": "#,0"
          },
          {
            "name": "Input tokens",
            "expression": "SUM(ClientModels[PromptTokens])",
            "formatString": "#,0"
          },
          {
            "name": "Output tokens",
            "expression": "SUM(ClientModels[OutputTokens])",
            "formatString": "#,0"
          },
          {
            "name": "IDE generations",
            "expression": "SUM(IDEs[Generations])",
            "formatString": "#,0"
          },
          {
            "name": "Language generations",
            "expression": "SUM(Languages[Generations])",
            "formatString": "#,0"
          },
          {
            "name": "Users without center history",
            "expression": "VAR Value = CALCULATE([Observed users], Centers[CenterId] = \"unattributed-history\") RETURN IF(NOT ISBLANK(Value), Value, IF([Complete metrics coverage] = 1, 0))",
            "formatString": "#,0"
          },
          {
            "name": "Users without client telemetry",
            "expression": "VAR Value = CALCULATE([Observed users], NOT ISBLANK(Metrics[TelemetryPresent]), Metrics[TelemetryPresent] = FALSE()) RETURN IF(NOT ISBLANK(Value), Value, IF([Complete metrics coverage] = 1, 0))",
            "formatString": "#,0"
          },
          {
            "name": "Measured budget USD",
            "expression": "IF(HASONEVALUE(Budgets[BudgetId]) && SELECTEDVALUE(Budgets[Scope]) = \"cost_center\" && SELECTEDVALUE(Budgets[ProductSKU]) = \"ai_credits\" && SELECTEDVALUE(Budgets[BudgetType]) = \"BundlePricing\", MAX(Budgets[BudgetAmount]))",
            "formatString": "\"$\"#,0.00"
          },
          {
            "name": "Consumed budget USD",
            "expression": "IF(NOT ISBLANK([Measured budget USD]), MAX(Budgets[ConsumedAmount]))",
            "formatString": "\"$\"#,0.00"
          },
          {
            "name": "Budget headroom USD",
            "expression": "IF(NOT ISBLANK([Measured budget USD]) && NOT ISBLANK([Consumed budget USD]), [Measured budget USD] - [Consumed budget USD])",
            "formatString": "\"$\"#,0.00"
          },
          {
            "name": "AI credit balance",
            "expression": "BLANK()",
            "formatString": "#,0.00"
          },
          {
            "name": "Balance status",
            "expression": "\"N/D: no budget or pool conversion without a verified unit\""
          },
          {
            "name": "Center notice",
            "expression": "\"A cost-center user assignment can also attribute GHE/Copilot/GHAS licenses. A name suffix does not separate products.\""
          },
          {
            "name": "Selected days",
            "expression": "COUNTROWS(VALUES('Dates'[Day]))",
            "formatString": "#,0"
          },
          {
            "name": "Selection start",
            "expression": "MINX(ALLSELECTED('Dates'), 'Dates'[Day])",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "Selection end",
            "expression": "MAXX(ALLSELECTED('Dates'), 'Dates'[Day])",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "License snapshot",
            "expression": "IF(SELECTEDVALUE(Info[LicenseRosterStatus]) = \"Complete snapshot, not historical\", COALESCE(DISTINCTCOUNT('Licenses'[User]), 0))",
            "formatString": "#,0"
          },
          {
            "name": "License snapshot date",
            "expression": "SELECTEDVALUE(Info[LicenseSnapshotAsOf])"
          },
          {
            "name": "Observed active users",
            "expression": "VAR Value = CALCULATE(DISTINCTCOUNT(Metrics[User]), Metrics[ActivityObserved] = TRUE()) RETURN IF(NOT ISBLANK(Value), Value, IF([Complete metrics coverage] = 1, 0))",
            "formatString": "#,0"
          },
          {
            "name": "Active user days",
            "expression": "VAR Value = CALCULATE(COUNTROWS(Metrics), Metrics[ActivityObserved] = TRUE()) RETURN IF(NOT ISBLANK(Value), Value, IF([Complete metrics coverage] = 1, 0))",
            "formatString": "#,0"
          },
          {
            "name": "Mean observed DAU",
            "expression": "IF([Complete metrics coverage] = 1, AVERAGEX(VALUES('Dates'[Day]), [Observed active users]))",
            "formatString": "#,0.0"
          },
          {
            "name": "Peak observed DAU",
            "expression": "IF([Complete metrics coverage] = 1, MAXX(VALUES('Dates'[Day]), [Observed active users]))",
            "formatString": "#,0"
          },
          {
            "name": "Peak DAU date",
            "expression": "VAR Peak = [Peak observed DAU] RETURN MINX(FILTER(VALUES('Dates'[Day]), [Observed active users] = Peak), 'Dates'[Day])",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "Mean active days per active user",
            "expression": "IF([Complete metrics coverage] = 1, DIVIDE([Active user days], [Observed active users]))",
            "formatString": "#,0.0"
          },
          {
            "name": "Complete metrics coverage",
            "expression": "VAR Days = COUNTROWS(VALUES('Dates'[Day])) RETURN IF(Days > 0 && Days = CALCULATE(COUNTROWS(SourceCoverage), KEEPFILTERS(SourceCoverage[MetricsAvailable] = TRUE())), 1, 0)",
            "formatString": "0"
          },
          {
            "name": "Metrics coverage status",
            "expression": "IF([Complete metrics coverage] = 1, \"Metrics available in selection\", \"PARTIAL: billing may be current; activity is observed only, do not infer zeros\")"
          },
          {
            "name": "Unknown activity rows",
            "expression": "VAR Value = COUNTROWS(FILTER(Metrics, ISBLANK(Metrics[ActivityObserved]))) RETURN IF(NOT ISBLANK(Value), Value, IF([Complete metrics coverage] = 1, 0))",
            "formatString": "#,0"
          },
          {
            "name": "Complete historical license coverage",
            "expression": "VAR SelectedDays = COUNTROWS(VALUES('Dates'[Day])) VAR CoveredDays = CALCULATE(COUNTROWS('LicenseCoverage'), 'LicenseCoverage'[HistoricalRosterComplete] = TRUE()) RETURN IF(SelectedDays > 0 && CoveredDays = SelectedDays && [Complete metrics coverage] = 1, 1, 0)",
            "formatString": "0"
          },
          {
            "name": "Historical licensed users",
            "expression": "IF([Complete historical license coverage] = 1, COALESCE(DISTINCTCOUNT('LicensedDays'[User]), 0))",
            "formatString": "#,0"
          },
          {
            "name": "Active licensed users",
            "expression": "IF([Complete historical license coverage] = 1, VAR Eligible = SELECTCOLUMNS('LicensedDays', \"D\", [Day], \"U\", [User]) VAR Active = SELECTCOLUMNS(FILTER(Metrics, Metrics[ActivityObserved] = TRUE()), \"D\", [Day], \"U\", [User]) RETURN COALESCE(COUNTROWS(DISTINCT(SELECTCOLUMNS(INTERSECT(Active, Eligible), \"U\", [U]))), 0))",
            "formatString": "#,0"
          },
          {
            "name": "Unobserved licensed pairs",
            "expression": "VAR Eligible = SELECTCOLUMNS('LicensedDays', \"D\", [Day], \"U\", [User]) VAR Known = SELECTCOLUMNS(FILTER(Metrics, NOT ISBLANK(Metrics[ActivityObserved])), \"D\", [Day], \"U\", [User]) RETURN COALESCE(COUNTROWS(EXCEPT(Eligible, Known)), 0)",
            "formatString": "#,0"
          },
          {
            "name": "Observed inactive users",
            "expression": "IF([Complete historical license coverage] = 1 && [Unobserved licensed pairs] = 0, [Historical licensed users] - [Active licensed users])",
            "formatString": "#,0"
          },
          {
            "name": "Period adoption",
            "expression": "IF([Complete historical license coverage] = 1 && [Unobserved licensed pairs] = 0, DIVIDE([Active licensed users], [Historical licensed users]))",
            "formatString": "0.0%"
          },
          {
            "name": "Adoption status",
            "expression": "IF([Complete historical license coverage] = 1 && [Unobserved licensed pairs] = 0, \"Observed activity / audited historical roster\", \"N/D: a snapshot is not a historical roster; do not infer inactive users\")"
          },
          {
            "name": "Complete ISO weeks",
            "expression": "VAR Value = VAR SelectedDays = ALLSELECTED('Dates') RETURN COUNTROWS(FILTER(SUMMARIZE(SelectedDays, 'Dates'[WeekStart]), VAR W = 'Dates'[WeekStart] RETURN COUNTROWS(FILTER(SelectedDays, 'Dates'[WeekStart] = W)) = 7 && CALCULATE(COUNTROWS(SourceCoverage), KEEPFILTERS(SourceCoverage[MetricsAvailable] = TRUE()), KEEPFILTERS('Dates'[WeekStart] = W)) = 7)) RETURN IF(NOT ISBLANK(Value), Value, IF([Complete metrics coverage] = 1, 0))",
            "formatString": "#,0"
          },
          {
            "name": "Complete weeks missing metrics",
            "expression": "VAR Value = VAR SelectedDays = ALLSELECTED('Dates') RETURN COUNTROWS(FILTER(SUMMARIZE(SelectedDays, 'Dates'[WeekStart]), VAR W = 'Dates'[WeekStart] RETURN COUNTROWS(FILTER(SelectedDays, 'Dates'[WeekStart] = W)) = 7 && CALCULATE(COUNTROWS(SourceCoverage), KEEPFILTERS(SourceCoverage[MetricsAvailable] = TRUE()), KEEPFILTERS('Dates'[WeekStart] = W)) < 7)) RETURN IF(NOT ISBLANK(Value), Value, IF([Complete metrics coverage] = 1, 0))",
            "formatString": "#,0"
          },
          {
            "name": "Recurring users three days",
            "expression": "VAR SelectedDays = ALLSELECTED('Dates') VAR CompleteWeeks = FILTER(SUMMARIZE(SelectedDays, 'Dates'[WeekStart]), VAR W = 'Dates'[WeekStart] RETURN COUNTROWS(FILTER(SelectedDays, 'Dates'[WeekStart] = W)) = 7 && CALCULATE(COUNTROWS(SourceCoverage), KEEPFILTERS(SourceCoverage[MetricsAvailable] = TRUE()), KEEPFILTERS('Dates'[WeekStart] = W)) = 7) RETURN IF(COUNTROWS(CompleteWeeks) > 0 && [Complete weeks missing metrics] = 0, COALESCE(COUNTROWS(FILTER(VALUES('Users'[User]), MAXX(CompleteWeeks, VAR W = 'Dates'[WeekStart] RETURN CALCULATE(DISTINCTCOUNT(Metrics[Day]), Metrics[ActivityObserved] = TRUE(), KEEPFILTERS('Dates'[WeekStart] = W))) >= 3)), 0))",
            "formatString": "#,0"
          },
          {
            "name": "Recurring share of eligible active users",
            "expression": "VAR SelectedDays = ALLSELECTED('Dates') VAR CompleteWeeks = FILTER(SUMMARIZE(SelectedDays, 'Dates'[WeekStart]), VAR W = 'Dates'[WeekStart] RETURN COUNTROWS(FILTER(SelectedDays, 'Dates'[WeekStart] = W)) = 7 && CALCULATE(COUNTROWS(SourceCoverage), KEEPFILTERS(SourceCoverage[MetricsAvailable] = TRUE()), KEEPFILTERS('Dates'[WeekStart] = W)) = 7) VAR ActiveInWeeks = CALCULATE([Observed active users], KEEPFILTERS(TREATAS(SELECTCOLUMNS(CompleteWeeks, \"W\", 'Dates'[WeekStart]), 'Dates'[WeekStart]))) RETURN IF(COUNTROWS(CompleteWeeks) > 0 && [Complete weeks missing metrics] = 0, DIVIDE([Recurring users three days], ActiveInWeeks))",
            "formatString": "0.0%"
          },
          {
            "name": "Lines deleted",
            "expression": "SUM(Metrics[LinesDeleted])",
            "formatString": "#,0"
          },
          {
            "name": "Suggested lines to delete",
            "expression": "SUM(Metrics[LinesSuggestedDelete])",
            "formatString": "#,0"
          },
          {
            "name": "Net lines",
            "expression": "IF(NOT ISBLANK([Lines added]) && NOT ISBLANK([Lines deleted]), [Lines added] - [Lines deleted])",
            "formatString": "#,0"
          },
          {
            "name": "Edited lines",
            "expression": "IF(NOT ISBLANK([Lines added]) && NOT ISBLANK([Lines deleted]), [Lines added] + [Lines deleted])",
            "formatString": "#,0"
          },
          {
            "name": "Inline accepted lines",
            "expression": "CALCULATE(SUM(Features[LinesAdded]), Features[Feature] = \"code_completion\")",
            "formatString": "#,0"
          },
          {
            "name": "Inline suggested lines",
            "expression": "CALCULATE(SUM(Features[LinesSuggested]), Features[Feature] = \"code_completion\")",
            "formatString": "#,0"
          },
          {
            "name": "Inline line acceptance rate",
            "expression": "DIVIDE([Inline accepted lines], [Inline suggested lines])",
            "formatString": "0.0%"
          },
          {
            "name": "Feature generations",
            "expression": "SUM(Features[Generations])",
            "formatString": "#,0"
          },
          {
            "name": "Feature acceptances",
            "expression": "SUM(Features[Acceptances])",
            "formatString": "#,0"
          },
          {
            "name": "Feature lines added",
            "expression": "SUM(Features[LinesAdded])",
            "formatString": "#,0"
          },
          {
            "name": "Feature lines deleted",
            "expression": "SUM(Features[LinesDeleted])",
            "formatString": "#,0"
          },
          {
            "name": "Feature users",
            "expression": "VAR Value = DISTINCTCOUNT(Features[User]) RETURN IF(NOT ISBLANK(Value), Value, IF([Complete metrics coverage] = 1, 0))",
            "formatString": "#,0"
          },
          {
            "name": "CLI prompts",
            "expression": "SUM('CLI'[Prompts])",
            "formatString": "#,0"
          },
          {
            "name": "CLI requests",
            "expression": "SUM('CLI'[Requests])",
            "formatString": "#,0"
          },
          {
            "name": "CLI sessions",
            "expression": "SUM('CLI'[Sessions])",
            "formatString": "#,0"
          },
          {
            "name": "Telemetry present rows",
            "expression": "VAR Value = CALCULATE(COUNTROWS(Metrics), Metrics[TelemetryPresent] = TRUE()) RETURN IF(NOT ISBLANK(Value), Value, IF([Complete metrics coverage] = 1, 0))",
            "formatString": "#,0"
          },
          {
            "name": "Telemetry absent rows",
            "expression": "VAR Value = CALCULATE(COUNTROWS(Metrics), NOT ISBLANK(Metrics[TelemetryPresent]), Metrics[TelemetryPresent] = FALSE()) RETURN IF(NOT ISBLANK(Value), Value, IF([Complete metrics coverage] = 1, 0))",
            "formatString": "#,0"
          },
          {
            "name": "Unknown telemetry rows",
            "expression": "VAR Value = COUNTROWS(FILTER(Metrics, ISBLANK(Metrics[TelemetryPresent]))) RETURN IF(NOT ISBLANK(Value), Value, IF([Complete metrics coverage] = 1, 0))",
            "formatString": "#,0"
          },
          {
            "name": "Known telemetry coverage",
            "expression": "DIVIDE([Telemetry present rows], [Telemetry present rows] + [Telemetry absent rows])",
            "formatString": "0.0%",
            "description": "Client telemetry present rate among known-status user-day rows: TRUE / (TRUE + FALSE). Unknown status is excluded; zero known rows returns blank, not zero. Not a percentage of users."
          },
          {
            "name": "Unmet requirements rows",
            "expression": "VAR Value = COUNTROWS(FILTER(Metrics, Metrics[RequirementsUnmet] > 0)) RETURN IF(NOT ISBLANK(Value), Value, IF([Complete metrics coverage] = 1, 0))",
            "formatString": "#,0"
          },
          {
            "name": "Unknown requirements rows",
            "expression": "VAR Value = COUNTROWS(FILTER(Metrics, ISBLANK(Metrics[RequirementsUnknown]) || Metrics[RequirementsUnknown] > 0)) RETURN IF(NOT ISBLANK(Value), Value, IF([Complete metrics coverage] = 1, 0))",
            "formatString": "#,0"
          },
          {
            "name": "Interpretation notice",
            "expression": "\"Volume and acceptance indicate usage, not ROI or individual productivity. Consider quality, coverage and feedback.\""
          },
          {
            "name": "Block14 start",
            "expression": "VAR I = SELECTEDVALUE('Periods14'[BlockIndex]) VAR StartDay = [Selection start] + 14 * I RETURN IF(NOT ISBLANK(I) && StartDay <= [Selection end], StartDay)",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "Block14 end",
            "expression": "VAR StartDay = [Block14 start] RETURN IF(NOT ISBLANK(StartDay), MIN(StartDay + 13, [Selection end]))",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "Block14 credits",
            "expression": "VAR StartDay = [Block14 start] VAR EndDay = [Block14 end] RETURN IF(NOT ISBLANK(StartDay), CALCULATE([Gross AI credits], KEEPFILTERS('Dates'[Day] >= StartDay), KEEPFILTERS('Dates'[Day] <= EndDay)))",
            "formatString": "#,0.00"
          },
          {
            "name": "IDE chat users",
            "expression": "IF(COUNTROWS(FILTER(Metrics, NOT ISBLANK(Metrics[UsedChat]))) > 0, COALESCE(CALCULATE(DISTINCTCOUNT(Metrics[User]), Metrics[UsedChat] = TRUE()), 0))",
            "formatString": "#,0"
          },
          {
            "name": "IDE agent users",
            "expression": "IF(COUNTROWS(FILTER(Metrics, NOT ISBLANK(Metrics[UsedAgent]))) > 0, COALESCE(CALCULATE(DISTINCTCOUNT(Metrics[User]), Metrics[UsedAgent] = TRUE()), 0))",
            "formatString": "#,0"
          },
          {
            "name": "CLI users",
            "expression": "IF(COUNTROWS(FILTER(Metrics, NOT ISBLANK(Metrics[UsedCLI]))) > 0, COALESCE(CALCULATE(DISTINCTCOUNT(Metrics[User]), Metrics[UsedCLI] = TRUE()), 0))",
            "formatString": "#,0"
          },
          {
            "name": "Copilot app users",
            "expression": "IF(COUNTROWS(FILTER(Metrics, NOT ISBLANK(Metrics[UsedCopilotApp]))) > 0, COALESCE(CALCULATE(DISTINCTCOUNT(Metrics[User]), Metrics[UsedCopilotApp] = TRUE()), 0))",
            "formatString": "#,0"
          },
          {
            "name": "Cloud agent users",
            "expression": "IF(COUNTROWS(FILTER(Metrics, NOT ISBLANK(Metrics[UsedCloudAgent]))) > 0, COALESCE(CALCULATE(DISTINCTCOUNT(Metrics[User]), Metrics[UsedCloudAgent] = TRUE()), 0))",
            "formatString": "#,0"
          },
          {
            "name": "Active code review users",
            "expression": "IF(COUNTROWS(FILTER(Metrics, NOT ISBLANK(Metrics[UsedCodeReviewActive]))) > 0, COALESCE(CALCULATE(DISTINCTCOUNT(Metrics[User]), Metrics[UsedCodeReviewActive] = TRUE()), 0))",
            "formatString": "#,0"
          },
          {
            "name": "Passive code review users",
            "expression": "IF(COUNTROWS(FILTER(Metrics, NOT ISBLANK(Metrics[UsedCodeReviewPassive]))) > 0, COALESCE(CALCULATE(DISTINCTCOUNT(Metrics[User]), Metrics[UsedCodeReviewPassive] = TRUE()), 0))",
            "formatString": "#,0"
          },
          {
            "name": "Top15 credits",
            "expression": "VAR Candidates = FILTER(ALLSELECTED('Users'[User]), 'Users'[User] <> \"(no user detail)\" && NOT ISBLANK(CALCULATE([Gross AI credits]))) VAR TopUsers = TOPN(15, Candidates, [Gross AI credits], DESC, 'Users'[User], ASC) RETURN IF(CONTAINS(TopUsers, 'Users'[User], SELECTEDVALUE('Users'[User])), [Gross AI credits])",
            "formatString": "#,0.00"
          },
          {
            "name": "Top15 generations",
            "expression": "VAR Candidates = FILTER(ALLSELECTED('Users'[User]), 'Users'[User] <> \"(no user detail)\" && NOT ISBLANK(CALCULATE([Generations]))) VAR TopUsers = TOPN(15, Candidates, [Generations], DESC, 'Users'[User], ASC) RETURN IF(CONTAINS(TopUsers, 'Users'[User], SELECTEDVALUE('Users'[User])), [Generations])",
            "formatString": "#,0"
          },
          {
            "name": "Top15 lines added",
            "expression": "VAR Candidates = FILTER(ALLSELECTED('Users'[User]), 'Users'[User] <> \"(no user detail)\" && NOT ISBLANK(CALCULATE([Lines added]))) VAR TopUsers = TOPN(15, Candidates, [Lines added], DESC, 'Users'[User], ASC) RETURN IF(CONTAINS(TopUsers, 'Users'[User], SELECTEDVALUE('Users'[User])), [Lines added])",
            "formatString": "#,0"
          },
          {
            "name": "Display Acceptances",
